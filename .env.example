# Skopiować do pliku .env i uzupełnić. Wszystkie zmienne VITE_* trafiają do kodu
# w przeglądarce (są widoczne publicznie) — nie wpisywać tu żadnych sekretów.
# Na Cloudflare ustawia się je w: Workers & Pages → projekt → Settings → Build → Variables.

# Klucz Google Maps Embed API (mapa na stronie głównej i w /kontakt).
# Bez klucza w miejscu mapy zostaje karta z linkiem do Google Maps.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Adres webhooka, który odbiera formularz zapytania o termin i wysyła e-maile.
VITE_WILLA_WEBHOOK=

# Nagłówek i wartość do autoryzacji webhooka (ochrona przed przypadkowymi botami).
VITE_WILLA_WEBHOOK_HEADER=
VITE_WILLA_WEBHOOK_TOKEN=
