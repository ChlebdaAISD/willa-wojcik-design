# Klucz do Google Maps Embed API (mapa w sekcji Lokalizacja i na /kontakt).
# Bez niego MapEmbed renderuje kartę z linkiem do Google Maps zamiast błędu.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Webhook n8n obsługujący formularz zapytania o termin.
# Workflow: „Willa Wójcik — rezerwacja [willa_wojcik_rezerwacja]" na n8n.aisolutions.design
VITE_WILLA_WEBHOOK=https://n8n.aisolutions.design/webhook/willa_wojcik_rezerwacja

# Autoryzacja nagłówkowa webhooka. To NIE jest tajne — Vite wkompilowuje zmienne
# VITE_* w paczkę frontu, więc wartość jest widoczna w przeglądarce. Służy wyłącznie
# do odsiania przypadkowych botów, nie do ochrony danych.
VITE_WILLA_WEBHOOK_HEADER=x-willa-wojcik
VITE_WILLA_WEBHOOK_TOKEN=
