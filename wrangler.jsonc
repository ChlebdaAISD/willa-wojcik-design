{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "willa-wojcik-design",
  "compatibility_date": "2026-07-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/public",
    // Strona prerenderowana (SSG) — każda ścieżka ma własny statyczny plik.
    // "404-page" = nieistniejąca ścieżka dostaje dist/public/404.html ze statusem 404
    // (prawdziwe 404, nie soft-404), z nawigacją i linkami do podstron.
    "not_found_handling": "404-page",
    // Domyślnie Cloudflare dokleja ukośnik na końcu: /apartamenty -> 307 -> /apartamenty/.
    // Nasze canonical i sitemap.xml podają adresy BEZ ukośnika, więc każdy reklamowany
    // Google'owi adres byłby przekierowaniem tymczasowym. "drop-trailing-slash" odwraca
    // zależność: /apartamenty oddaje 200, a /apartamenty/ przekierowuje na wersję bez.
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
