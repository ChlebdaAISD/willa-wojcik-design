{
  "name": "willa-wojcik-design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:static",
    "build:client": "vite build",
    "build:ssr": "vite build --config vite.config.ssr.js",
    "build:prerender": "node scripts/prerender.js",
    "build:static": "npm run build:client && npm run build:ssr && npm run build:prerender",
    "preview": "npm run build:static && wrangler dev",
    "deploy": "npm run build:static && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.3",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.90.0"
  }
}
